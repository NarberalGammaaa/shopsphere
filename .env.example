MYSQL_DATABASE=shopsphere
MYSQL_USER=shop
MYSQL_PASSWORD=change_me_shop
MYSQL_PORT=3307
WEB_PORT=3000

# Base64, >= 32 bytes decoded. Generate with:  openssl rand -base64 48
JWT_SECRET=pvVx3ADeAs6wQgZhSqFzcfpjTBc9x+qNIbOR9T1P2Pucw78PvUVbT0b43yeSUi16

# Optional: first-start admin account (only used when it does not exist yet)
